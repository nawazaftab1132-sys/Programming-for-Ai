import numpy as np

print("------------No 5------------")

data = np.array([[2, 9, 4],
                 [7, 1, 8]])

print("Sum of all : ", data.sum())

print("column means", data.mean(axis=0))

print("row maximum", data.max(axis=1))

print("argmax per row ", data.argmax(axis=1))

print("Stored rows")

print(np.sort(data, axis=1))

print("argsort row")

print(np.argsort(data, axis=1))


